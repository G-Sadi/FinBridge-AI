# FinBridge AI Study Abroad Finance Advisor — Frontend Environment Variables
# Copy to .env or .env.local to configure

# Optional: Google Gemini API Key for client-side execution on GitHub Pages
# Users can also paste this directly in the website UI via the "🔑 API Key" button
VITE_GEMINI_API_KEY=

# Optional: Backend API URL (defaults to '' for same-domain or relative /api proxy)
# For local development with Flask, this can be left empty
VITE_API_BASE_URL=

